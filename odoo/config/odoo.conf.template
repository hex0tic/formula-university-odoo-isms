[options]
; Generated by scripts/setup.sh from this template. Do not commit odoo.conf (contains secrets).
addons_path = /mnt/extra-addons,/usr/lib/python3/dist-packages/odoo/addons
data_dir = /var/lib/odoo
admin_passwd = __ADMIN_PASSWD__
db_host = db
db_port = 5432
db_user = odoo
db_password = __POSTGRES_PASSWORD__
db_name = orgil_isms
dbfilter = ^orgil_isms$
; A.8.9 тохиргооны хатууруулалт: вэбээс DB manager-ийг хаах
list_db = False
without_demo = all
proxy_mode = False
workers = 0
max_cron_threads = 1
limit_time_cpu = 300
limit_time_real = 600
; A.8.15 Logging: файлын лог хадгалах
logfile = /var/log/odoo/odoo.log
log_level = info
log_handler = :INFO,werkzeug:INFO
