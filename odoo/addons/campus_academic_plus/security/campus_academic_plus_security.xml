<odoo>
    <!-- Sessions: students see sessions of offerings they are enrolled in; lecturers their own offerings. -->
    <record id="rule_session_student" model="ir.rule">
        <field name="name">Student reads sessions of enrolled offerings</field>
        <field name="model_id" ref="model_campus_session"/>
        <field name="groups" eval="[(4, ref('campus_university.group_campus_student'))]"/>
        <field name="domain_force">[('offering_id.enrollment_ids.student_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_session_lecturer" model="ir.rule">
        <field name="name">Lecturer reads sessions of own offerings</field>
        <field name="model_id" ref="model_campus_session"/>
        <field name="groups" eval="[(4, ref('campus_university.group_campus_lecturer'))]"/>
        <field name="domain_force">[('offering_id.lecturer_id', '=', user.id)]</field>
    </record>
    <record id="rule_session_registry" model="ir.rule">
        <field name="name">Registrar and auditor read all sessions</field>
        <field name="model_id" ref="model_campus_session"/>
        <field name="groups" eval="[(4, ref('campus_university.group_campus_registrar')), (4, ref('campus_university.group_campus_auditor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Attendance: a student sees only own rows; a lecturer only rows of own offerings. -->
    <record id="rule_attendance_student" model="ir.rule">
        <field name="name">Student reads own attendance</field>
        <field name="model_id" ref="model_campus_attendance"/>
        <field name="groups" eval="[(4, ref('campus_university.group_campus_student'))]"/>
        <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_attendance_lecturer" model="ir.rule">
        <field name="name">Lecturer manages attendance of own offerings</field>
        <field name="model_id" ref="model_campus_attendance"/>
        <field name="groups" eval="[(4, ref('campus_university.group_campus_lecturer'))]"/>
        <field name="domain_force">[('session_id.offering_id.lecturer_id', '=', user.id)]</field>
    </record>
    <record id="rule_attendance_registry" model="ir.rule">
        <field name="name">Registrar and auditor read all attendance</field>
        <field name="model_id" ref="model_campus_attendance"/>
        <field name="groups" eval="[(4, ref('campus_university.group_campus_registrar')), (4, ref('campus_university.group_campus_auditor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Students browse open offerings to register for them (added to existing student offering rule). -->
    <record id="rule_offering_open_student" model="ir.rule">
        <field name="name">Student reads open offerings for registration</field>
        <field name="model_id" ref="campus_university.model_campus_offering"/>
        <field name="groups" eval="[(4, ref('campus_university.group_campus_student'))]"/>
        <field name="domain_force">[('state', '=', 'open')]</field>
    </record>
</odoo>
