<odoo>
    <record id="group_campus_isms_auditor" model="res.groups">
        <field name="name">Campus and ISMS Auditor</field>
        <field name="implied_ids" eval="[(4, ref('campus_university.group_campus_auditor')), (4, ref('university_isms.group_isms_auditor'))]"/>
        <field name="comment">Read academic records and ISMS evidence without modifying either.</field>
    </record>
    <!-- Incident intake is provided by the portal; the academic role gives no ISMS group. -->
    <record id="campus_university.group_campus_user" model="res.groups">
        <field name="implied_ids" eval="[(3, ref('university_isms.group_isms_reporter'))]"/>
    </record>
</odoo>
