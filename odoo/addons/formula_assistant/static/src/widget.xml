<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="formula_assistant.Widget">
        <aside t-if="state.ready" class="fua" t-att-data-size="state.size" aria-label="Form туслах" t-on-keydown="onKeydown">
            <button t-if="state.hidden" t-ref="restore" type="button" class="fua-restore" t-on-click="() => this.save({hidden: false})" t-att-disabled="state.saving" aria-label="Form-г харуулах">
                <span class="fua-dot" aria-hidden="true"/> Form
            </button>
            <t t-else="">
                <section t-if="state.panel === 'greeting'" class="fua-panel fua-greeting" aria-label="Өдрийн сануулга">
                    <div class="fua-panel-head">
                        <span class="fua-kicker"><span class="fua-dot" aria-hidden="true"/> ӨДРИЙН САНУУЛГА</span>
                        <button type="button" class="fua-icon" aria-label="Сануулгыг хаах" t-on-click="close">×</button>
                    </div>
                    <p class="fua-hello">Сайн уу, <t t-esc="state.name"/>!</p>
                    <p><t t-esc="state.greeting.text"/></p>
                    <t t-call="formula_assistant.Items"><t t-set="items" t-value="state.greeting.items"/></t>
                    <button type="button" class="fua-primary" t-on-click="() => this.open('chat')">Form-той чатлах <span aria-hidden="true">↗</span></button>
                </section>
                <section t-if="state.panel === 'settings'" class="fua-panel fua-settings" aria-label="Form-ийн тохиргоо">
                    <div class="fua-panel-head">
                        <strong>Form-ийн тохиргоо</strong>
                        <button type="button" class="fua-icon" aria-label="Тохиргоог хаах" t-on-click="close">×</button>
                    </div>
                    <p>Дүрийн хэмжээ</p>
                    <div class="fua-segments" role="group" aria-label="Дүрийн хэмжээ">
                        <button type="button" t-att-aria-pressed="state.size === 'small' ? 'true' : 'false'" t-att-disabled="state.saving" t-on-click="() => this.save({size: 'small'})">Жижиг</button>
                        <button type="button" t-att-aria-pressed="state.size === 'normal' ? 'true' : 'false'" t-att-disabled="state.saving" t-on-click="() => this.save({size: 'normal'})">Дунд</button>
                        <button type="button" t-att-aria-pressed="state.size === 'large' ? 'true' : 'false'" t-att-disabled="state.saving" t-on-click="() => this.save({size: 'large'})">Том</button>
                    </div>
                    <button type="button" class="fua-hide" t-att-disabled="state.saving" t-on-click="() => this.save({hidden: true})">Дүрийг нуух</button>
                </section>
                <section t-if="state.panel === 'chat'" class="fua-panel fua-chat" aria-label="Form чат">
                    <div class="fua-panel-head">
                        <div><strong>Form</strong><div class="fua-caption">Миний ажил, хичээл</div></div>
                        <button type="button" class="fua-icon" aria-label="Чатыг хаах" t-on-click="close">×</button>
                    </div>
                    <div class="fua-transcript" t-ref="thread" role="log" aria-label="Мессежүүд" aria-live="polite">
                        <p t-if="!state.messages.length" class="fua-bubble">Сайн уу! Өнөөдрийн ажил эсвэл хичээлийн хуваариа асуугаарай.</p>
                        <div t-foreach="state.messages" t-as="msg" t-key="msg.id" t-attf-class="fua-bubble fua-bubble--{{msg.role}}">
                            <span class="visually-hidden" t-esc="msg.role === 'user' ? 'Та: ' : 'Form: '"/>
                            <div t-esc="msg.text"/>
                            <t t-call="formula_assistant.Items"><t t-set="items" t-value="msg.items"/></t>
                        </div>
                        <p t-if="state.busy" class="fua-busy" role="status">Form хариулж байна…</p>
                    </div>
                    <div class="fua-prompts" t-if="!state.messages.length">
                        <button type="button" t-on-click="() => this.ask('Өнөөдрийн ажил')">Өнөөдрийн ажил</button>
                        <button type="button" t-on-click="() => this.ask('Хичээлийн хуваарь')">Хичээлийн хуваарь</button>
                    </div>
                    <form class="fua-form" t-on-submit.prevent="() => this.ask()">
                        <input type="text" t-ref="input" t-model="state.draft" maxlength="300" autocomplete="off" aria-label="Асуулт" placeholder="Form-оос асуугаарай…"/>
                        <button type="submit" class="fua-primary" aria-label="Асуулт илгээх" t-att-disabled="state.busy or !state.draft.trim()">↑</button>
                    </form>
                </section>
                <p t-if="state.error" class="fua-error" role="alert"><t t-esc="state.error"/></p>
                <div class="fua-companion">
                    <button type="button" t-ref="pet" class="fua-pet" aria-label="Form чат нээх" t-att-aria-expanded="state.panel === 'chat' ? 'true' : 'false'" t-on-click="() => this.open('chat')">
                        <img src="/formula_assistant/static/src/form.svg" alt="" width="124" height="126" draggable="false"/>
                    </button>
                    <div class="fua-dock" aria-label="Form удирдлага">
                        <button type="button" title="Чат" aria-label="Чат" t-att-aria-pressed="state.panel === 'chat' ? 'true' : 'false'" t-on-click="() => this.open('chat')">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5H5l1.4-3A7.5 7.5 0 1 1 20 11.5Z"/><path d="M9.5 11.5h.01m3 0h.01m3 0h.01"/></svg>
                        </button>
                        <button type="button" title="Тохиргоо" aria-label="Тохиргоо" t-att-aria-pressed="state.panel === 'settings' ? 'true' : 'false'" t-on-click="() => this.open('settings')">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/><path d="M8 3v6m8 0v6m-7 0v6"/></svg>
                        </button>
                    </div>
                </div>
            </t>
        </aside>
    </t>
    <t t-name="formula_assistant.Items">
        <ul class="fua-items" t-if="items and items.length">
            <li t-foreach="items" t-as="item" t-key="item_index">
                <a t-if="item.url" t-att-href="item.url" t-esc="item.text"/>
                <t t-else="" t-esc="item.text"/>
            </li>
        </ul>
    </t>
</templates>
