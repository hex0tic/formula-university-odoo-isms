<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="isms_asset_view_form_stock" model="ir.ui.view">
        <field name="name">isms.asset.form.stock</field>
        <field name="model">isms.asset</field>
        <field name="inherit_id" ref="university_isms.isms_asset_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location']" position="after">
                <field name="product_id" invisible="asset_type != 'hardware'"/>
                <field name="lot_id" invisible="asset_type != 'hardware'" context="{'default_product_id': product_id}"/>
                <field name="stock_location_id" invisible="not lot_id"/>
            </xpath>
        </field>
    </record>
    <record id="isms_asset_view_list_stock" model="ir.ui.view">
        <field name="name">isms.asset.list.stock</field>
        <field name="model">isms.asset</field>
        <field name="inherit_id" ref="university_isms.isms_asset_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location']" position="after">
                <field name="lot_id" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="stock_lot_view_form_isms" model="ir.ui.view">
        <field name="name">stock.lot.form.isms</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_isms_assets" type="object" class="oe_stat_button" icon="fa-shield"
                        groups="university_isms.group_isms_asset_owner,university_isms.group_isms_auditor">
                    <field name="isms_asset_count" widget="statinfo" string="ISMS хөрөнгө"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
