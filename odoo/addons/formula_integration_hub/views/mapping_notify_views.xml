<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_formula_integration_mapping_list" model="ir.ui.view">
        <field name="name">formula.integration.mapping.list</field>
        <field name="model">formula.integration.mapping</field>
        <field name="arch" type="xml">
            <list string="ID холбоосууд" create="0">
                <field name="endpoint_id"/>
                <field name="local_model"/>
                <field name="local_id"/>
                <field name="remote_id"/>
                <field name="remote_kind"/>
                <field name="last_seen"/>
            </list>
        </field>
    </record>
    <record id="action_formula_integration_mapping" model="ir.actions.act_window">
        <field name="name">ID холбоосууд</field>
        <field name="res_model">formula.integration.mapping</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_formula_notification_log_list" model="ir.ui.view">
        <field name="name">formula.notification.log.list</field>
        <field name="model">formula.notification.log</field>
        <field name="arch" type="xml">
            <list string="Мэдэгдлийн бүртгэл" create="0" edit="0">
                <field name="create_date" string="Огноо"/>
                <field name="user_id"/>
                <field name="category"/>
                <field name="channel"/>
                <field name="template_ref"/>
                <field name="state"/>
                <field name="note"/>
            </list>
        </field>
    </record>
    <record id="action_formula_notification_log" model="ir.actions.act_window">
        <field name="name">Мэдэгдлийн бүртгэл</field>
        <field name="res_model">formula.notification.log</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_formula_notification_preference_list" model="ir.ui.view">
        <field name="name">formula.notification.preference.list</field>
        <field name="model">formula.notification.preference</field>
        <field name="arch" type="xml">
            <list string="Мэдэгдлийн тохиргоо" editable="bottom">
                <field name="user_id"/>
                <field name="category"/>
                <field name="email"/>
                <field name="inbox"/>
            </list>
        </field>
    </record>
    <record id="view_formula_notification_preference_form" model="ir.ui.view">
        <field name="name">formula.notification.preference.form</field>
        <field name="model">formula.notification.preference</field>
        <field name="arch" type="xml">
            <form string="Миний мэдэгдлийн тохиргоо">
                <sheet>
                    <group>
                        <field name="user_id" readonly="1"/>
                        <field name="category"/>
                        <field name="email"/>
                        <field name="inbox"/>
                    </group>
                    <div class="text-muted">
                        Аюулгүй байдлын (security) мэдэгдлийг унтрааж болохгүй. Академик болон системийн мэдэгдлийг унтраана.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_formula_notification_preference" model="ir.actions.act_window">
        <field name="name">Миний мэдэгдэл</field>
        <field name="res_model">formula.notification.preference</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_user_id': uid}</field>
        <field name="domain">[('user_id', '=', uid)]</field>
    </record>
</odoo>
