<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Хэрэглэгч өөрийн мэдэгдлийн тохиргоотойгоо л ажиллана; админ бүгдийг. -->
    <record id="rule_notification_pref_owner" model="ir.rule">
        <field name="name">Мэдэгдэл: хэрэглэгч зөвхөн өөрийн тохиргоо</field>
        <field name="model_id" ref="model_formula_notification_preference"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_notification_pref_admin" model="ir.rule">
        <field name="name">Мэдэгдэл: системийн админ бүгдийг</field>
        <field name="model_id" ref="model_formula_notification_preference"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
