<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="access_review_view_form" model="ir.ui.view">
        <field name="name">access.review.form</field>
        <field name="model">access.review</field>
        <field name="arch" type="xml">
            <form string="Хэрэглэгчийн эрхийн тойм">
                <header>
                    <button name="action_refresh" type="object" string="Дахин тооцоолох" class="btn-secondary"
                            invisible="not user_id"/>
                    <button name="action_apply_groups" type="object" string="Эрхийг хадгалах" class="btn-primary"
                            invisible="not user_id"
                            confirm="Сонгосон эрхийн бүлгүүдээр хэрэглэгчийн эрхийг шинэчлэх үү? Өөрчлөлт аудит логт бүртгэгдэнэ."/>
                    <button name="action_open_user" type="object" string="Хэрэглэгчийн карт" invisible="not user_id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="user_id"/>
                        <h1><field name="user_id" placeholder="Хэрэглэгч сонгоно уу" options="{'no_create': True}"/></h1>
                    </div>
                    <group invisible="not user_id">
                        <group string="Хэрэглэгч">
                            <field name="login"/>
                            <field name="job_title" readonly="1" force_save="1"/>
                            <field name="department" readonly="1" force_save="1"/>
                            <field name="isms_role" readonly="1" force_save="1"/>
                        </group>
                        <group string="Товч дүн">
                            <field name="model_summary" readonly="1" force_save="1"/>
                            <field name="project_summary" readonly="1" force_save="1"/>
                            <field name="channel_summary" readonly="1" force_save="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status" invisible="not user_id">
                        Эрхийг тухайн хэрэглэгчийн нэрээр бодитоор тооцоолсон: эрхийн бүлэг, хандах эрх,
                        бичлэгийн дүрэм бүгд орсон. Энэ хуудсыг зөвхөн эрх өөрчлөх эрхтэй ажилтан харна.
                        Ажилтан өөрийн эрхийг харахгүй, хориглогдсон үйлдэл хийх үед л мэдэгдэл авна.
                    </div>
                    <notebook invisible="not user_id">
                        <page string="Модел ба бичлэг" name="models">
                            <field name="model_line_ids" readonly="1" force_save="1">
                                <list create="0" delete="0">
                                    <field name="sequence" column_invisible="1" force_save="1"/>
                                    <field name="category" force_save="1"/>
                                    <field name="name" force_save="1"/>
                                    <field name="model" optional="hide" force_save="1"/>
                                    <field name="can_read" force_save="1"/>
                                    <field name="can_write" force_save="1"/>
                                    <field name="can_create" force_save="1"/>
                                    <field name="can_unlink" force_save="1"/>
                                    <field name="visible_count" force_save="1"/>
                                    <field name="writable_count" force_save="1"/>
                                    <field name="total_count" force_save="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Төслүүд" name="projects">
                            <field name="project_line_ids" readonly="1" force_save="1">
                                <list create="0" delete="0">
                                    <field name="name" force_save="1"/>
                                    <field name="can_read" force_save="1"/>
                                    <field name="can_write" force_save="1"/>
                                    <field name="task_visible" force_save="1"/>
                                    <field name="task_total" force_save="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Чат" name="channels">
                            <field name="channel_line_ids" readonly="1" force_save="1">
                                <list create="0" delete="0">
                                    <field name="name" force_save="1"/>
                                    <field name="channel_type" force_save="1"/>
                                    <field name="member_count" force_save="1"/>
                                    <field name="is_member" force_save="1"/>
                                    <field name="can_read" force_save="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Бизнесийн үйлдэл" name="actions">
                            <field name="action_line_ids" readonly="1" force_save="1">
                                <list create="0" delete="0" decoration-muted="not allowed">
                                    <field name="sequence" column_invisible="1" force_save="1"/>
                                    <field name="category" force_save="1"/>
                                    <field name="name" force_save="1"/>
                                    <field name="allowed" force_save="1"/>
                                    <field name="required_groups" force_save="1"/>
                                    <field name="note" force_save="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Эрхийн бүлэг (өөрчлөх)" name="groups">
                            <p class="text-muted">
                                Олгосон баганыг сонгож, дээрх Эрхийг хадгалах товчийг дарна. Удамшсан бүлэг нь өөр
                                бүлгээс автоматаар ирдэг тул тэр бүлгийг хасахгүй бол хадгалсны дараа буцаж гарна.
                            </p>
                            <field name="group_line_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="category" readonly="1" force_save="1"/>
                                    <field name="group_id" readonly="1" force_save="1"/>
                                    <field name="granted" widget="boolean_toggle"/>
                                    <field name="inherited" readonly="1" force_save="1"/>
                                    <field name="implied_by" readonly="1" force_save="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="access_review_action" model="ir.actions.act_window">
        <field name="name">Хэрэглэгчийн эрхийн тойм</field>
        <field name="res_model">access.review</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="access_review_menu" name="Хэрэглэгчийн эрхийн тойм" parent="base.menu_users"
              action="access_review_action" sequence="5" groups="base.group_erp_manager"/>

    <record id="res_users_view_form_access_review" model="ir.ui.view">
        <field name="name">res.users.form.access.review</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_access_review" type="object" class="oe_stat_button" icon="fa-shield"
                        string="Эрхийн тойм" groups="base.group_erp_manager"/>
            </div>
        </field>
    </record>
</odoo>
