<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="formula_design_system.ThemeToggle">
    <div class="o_fds_theme_toggle d-flex align-items-center">
        <button type="button"
                class="btn fds-icon-btn fds-theme-toggle"
                t-att-aria-label="label"
                t-att-title="label"
                t-att-aria-pressed="isDark ? 'true' : 'false'"
                t-on-click="onToggle">
            <svg t-if="isDark" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
            </svg>
            <svg t-else="" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
        </button>
    </div>
</t>

</templates>
