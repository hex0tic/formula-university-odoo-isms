<?xml version="1.0" encoding="utf-8"?>
<!-- RBAC (A.5.15 Access control, A.5.18 Access rights, A.8.2 Privileged access, A.5.3 Segregation of duties)
     Түвшин: 1 Мэдээлэгч → 2 Хөрөнгө эзэмшигч → 4 МАБ шинжээч → 5 МАБ менежер (CISO)
             3 Дотоод аудитор (зөвхөн унших, тусдаа ангилал) ; 6 Odoo Settings (base.group_system) -->
<odoo>
    <record id="module_category_isms" model="ir.module.category">
        <field name="name">ISMS</field>
        <field name="description">Мэдээллийн аюулгүй байдлын удирдлагын тогтолцооны эрхийн түвшин</field>
        <field name="sequence">4</field>
    </record>
    <record id="module_category_isms_audit" model="ir.module.category">
        <field name="name">ISMS аудит</field>
        <field name="description">Хараат бус, зөвхөн унших эрхтэй дотоод аудит (A.5.35)</field>
        <field name="sequence">5</field>
    </record>

    <record id="group_isms_reporter" model="res.groups">
        <field name="name">1. Мэдээлэгч (Reporter)</field>
        <field name="category_id" ref="module_category_isms"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Багш, ажилтан: инцидент мэдээлэх, өөрийн мэдээлсэн инцидент, батлагдсан бодлогыг харах.</field>
    </record>
    <record id="group_isms_asset_owner" model="res.groups">
        <field name="name">2. Хөрөнгө эзэмшигч (Asset Owner)</field>
        <field name="category_id" ref="module_category_isms"/>
        <field name="implied_ids" eval="[(4, ref('group_isms_reporter'))]"/>
        <field name="comment">Нэгжийн дарга: хөрөнгийн бүртгэлийг харах, өөрийн хөрөнгийг засах, өөрийн хөрөнгийн эрсдэлийг харах.</field>
    </record>
    <record id="group_isms_analyst" model="res.groups">
        <field name="name">4. МАБ шинжээч (Security Analyst)</field>
        <field name="category_id" ref="module_category_isms"/>
        <field name="implied_ids" eval="[(4, ref('group_isms_asset_owner')), (4, ref('project.group_project_user'))]"/>
        <field name="comment">МТТ-ийн инженер: хөрөнгө, эрсдэл, инцидент, SoA-г удирдах, шалгах.</field>
    </record>
    <record id="group_isms_auditor" model="res.groups">
        <field name="name">3. Дотоод аудитор (Auditor — зөвхөн унших)</field>
        <field name="category_id" ref="module_category_isms_audit"/>
        <field name="implied_ids" eval="[(4, ref('group_isms_reporter'))]"/>
        <field name="comment">ISMS-ийн бүх бүртгэл болон аудит логийг зөвхөн уншина. Өөрчлөх эрхгүй (үүрэг салгах).</field>
    </record>
    <record id="group_isms_manager" model="res.groups">
        <field name="name">5. МАБ менежер (CISO)</field>
        <field name="category_id" ref="module_category_isms"/>
        <field name="implied_ids" eval="[(4, ref('group_isms_analyst')), (4, ref('group_isms_auditor'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Эрсдэл хүлээн зөвшөөрөх, бодлого батлах, инцидент хаах, SoA-г батлах.</field>
    </record>

    <!-- ===== Record rules ===== -->
    <!-- Хөрөнгө: эзэмшигч зөвхөн өөрийн хөрөнгийг засна; шинжээч бүгдийг -->
    <record id="rule_asset_owner_write" model="ir.rule">
        <field name="name">Хөрөнгө: эзэмшигч өөрийн хөрөнгийг засна</field>
        <field name="model_id" ref="model_isms_asset"/>
        <field name="domain_force">['|', ('owner_id', '=', user.id), ('custodian_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_isms_asset_owner'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_asset_analyst_all" model="ir.rule">
        <field name="name">Хөрөнгө: МАБ шинжээч бүгдийг</field>
        <field name="model_id" ref="model_isms_asset"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_isms_analyst'))]"/>
        <field name="perm_read" eval="False"/>
    </record>

    <!-- Эрсдэл: эзэмшигч зөвхөн өөрийн хөрөнгө/хариуцсан эрсдэлийг харна -->
    <record id="rule_risk_owner_read" model="ir.rule">
        <field name="name">Эрсдэл: эзэмшигч өөрийн хөрөнгийн эрсдэл</field>
        <field name="model_id" ref="model_isms_risk"/>
        <field name="domain_force">['|', ('owner_id', '=', user.id), ('asset_ids.owner_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_isms_asset_owner'))]"/>
    </record>
    <record id="rule_risk_all" model="ir.rule">
        <field name="name">Эрсдэл: шинжээч, аудитор бүгдийг</field>
        <field name="model_id" ref="model_isms_risk"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_isms_analyst')), (4, ref('group_isms_auditor'))]"/>
    </record>

    <!-- Инцидент: мэдээлэгч өөрийнхөө мэдээлснийг; эзэмшигч өөрийн хөрөнгийн инцидентийг харна -->
    <record id="rule_incident_reporter" model="ir.rule">
        <field name="name">Инцидент: мэдээлэгч өөрийн мэдээлсэн</field>
        <field name="model_id" ref="model_isms_incident"/>
        <field name="domain_force">[('reporter_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_isms_reporter'))]"/>
    </record>
    <record id="rule_incident_owner_read" model="ir.rule">
        <field name="name">Инцидент: эзэмшигч өөрийн хөрөнгийн</field>
        <field name="model_id" ref="model_isms_incident"/>
        <field name="domain_force">[('asset_ids.owner_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_isms_asset_owner'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_incident_all" model="ir.rule">
        <field name="name">Инцидент: шинжээч, аудитор бүгдийг</field>
        <field name="model_id" ref="model_isms_incident"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_isms_analyst')), (4, ref('group_isms_auditor'))]"/>
    </record>

    <!-- Бодлого: энгийн хэрэглэгч зөвхөн батлагдсан бодлогыг харна -->
    <record id="rule_policy_reporter" model="ir.rule">
        <field name="name">Бодлого: батлагдсан бодлого</field>
        <field name="model_id" ref="model_isms_policy"/>
        <field name="domain_force">[('state', '=', 'approved')]</field>
        <field name="groups" eval="[(4, ref('group_isms_reporter'))]"/>
    </record>
    <record id="rule_policy_all" model="ir.rule">
        <field name="name">Бодлого: шинжээч, аудитор бүгдийг</field>
        <field name="model_id" ref="model_isms_policy"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_isms_analyst')), (4, ref('group_isms_auditor'))]"/>
    </record>
    <record id="rule_policy_ack_own" model="ir.rule">
        <field name="name">Танилцсан бүртгэл: өөрийнх</field>
        <field name="model_id" ref="model_isms_policy_ack"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_isms_reporter'))]"/>
    </record>
    <record id="rule_policy_ack_all" model="ir.rule">
        <field name="name">Танилцсан бүртгэл: менежер, аудитор бүгдийг</field>
        <field name="model_id" ref="model_isms_policy_ack"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_isms_analyst')), (4, ref('group_isms_auditor'))]"/>
    </record>
</odoo>
