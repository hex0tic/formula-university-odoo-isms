<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_view_form_isms" model="ir.ui.view">
        <field name="name">project.task.form.isms</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_deadline']" position="after">
                <field name="isms_risk_id" groups="university_isms.group_isms_analyst,university_isms.group_isms_auditor"/>
            </xpath>
        </field>
    </record>
</odoo>
