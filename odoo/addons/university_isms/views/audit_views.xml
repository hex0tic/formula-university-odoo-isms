<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="isms_audit_log_view_list" model="ir.ui.view">
        <field name="name">isms.audit.log.list</field>
        <field name="model">isms.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="action in ('login_failed', 'unlink')"
                  decoration-warning="action == 'access_change'"
                  decoration-muted="action == 'login'">
                <field name="timestamp"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="login" optional="hide"/>
                <field name="action" widget="badge"
                       decoration-danger="action in ('login_failed', 'unlink')"
                       decoration-warning="action == 'access_change'"
                       decoration-info="action in ('create', 'write', 'state')"
                       decoration-success="action == 'login'"/>
                <field name="model_name"/>
                <field name="res_name"/>
                <field name="changes"/>
                <field name="ip_address"/>
            </list>
        </field>
    </record>

    <record id="isms_audit_log_view_form" model="ir.ui.view">
        <field name="name">isms.audit.log.form</field>
        <field name="model">isms.audit.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Аудит лог өөрчлөх, устгах боломжгүй (ISO/IEC 27001:2022 A.8.15).
                    </div>
                    <group>
                        <group>
                            <field name="timestamp"/>
                            <field name="user_id"/>
                            <field name="login"/>
                            <field name="ip_address"/>
                        </group>
                        <group>
                            <field name="action"/>
                            <field name="model_name"/>
                            <field name="model"/>
                            <field name="res_id"/>
                            <field name="res_name"/>
                        </group>
                    </group>
                    <separator string="Өөрчлөлт"/>
                    <field name="changes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="isms_audit_log_view_search" model="ir.ui.view">
        <field name="name">isms.audit.log.search</field>
        <field name="model">isms.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="login"/>
                <field name="res_name"/>
                <field name="model_name"/>
                <field name="changes"/>
                <field name="ip_address"/>
                <filter name="f_auth" string="Нэвтрэлт" domain="[('action', 'in', ('login', 'login_failed'))]"/>
                <filter name="f_failed" string="Амжилтгүй нэвтрэлт" domain="[('action', '=', 'login_failed')]"/>
                <filter name="f_access" string="Эрхийн өөрчлөлт" domain="[('action', '=', 'access_change')]"/>
                <filter name="f_data" string="Өгөгдлийн өөрчлөлт" domain="[('action', 'in', ('create', 'write', 'state', 'unlink'))]"/>
                <filter name="f_unlink" string="Устгасан" domain="[('action', '=', 'unlink')]"/>
                <separator/>
                <filter name="f_today" string="Өнөөдөр" domain="[('timestamp', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="f_timestamp" string="Огноо" date="timestamp"/>
                <group>
                    <filter name="g_user" string="Хэрэглэгч" context="{'group_by': 'user_id'}"/>
                    <filter name="g_action" string="Үйлдэл" context="{'group_by': 'action'}"/>
                    <filter name="g_model" string="Объект" context="{'group_by': 'model_name'}"/>
                    <filter name="g_day" string="Өдөр" context="{'group_by': 'timestamp:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="isms_audit_log_view_pivot" model="ir.ui.view">
        <field name="name">isms.audit.log.pivot</field>
        <field name="model">isms.audit.log</field>
        <field name="arch" type="xml">
            <pivot string="Аудит лог">
                <field name="user_id" type="row"/>
                <field name="action" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_isms_audit_log" model="ir.actions.act_window">
        <field name="name">Аудит лог</field>
        <field name="res_model">isms.audit.log</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Аудит бичлэг хараахан алга</p>
            <p>Нэвтрэлт, эрхийн өөрчлөлт, ISMS бүртгэлийн үүсгэх/өөрчлөх/устгах үйлдэл энд автоматаар бичигдэнэ.</p>
        </field>
    </record>
</odoo>
