<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="isms_risk_view_list" model="ir.ui.view">
        <field name="name">isms.risk.list</field>
        <field name="model">isms.risk</field>
        <field name="arch" type="xml">
            <list decoration-danger="level == 'high'" decoration-warning="level == 'medium'">
                <field name="code"/>
                <field name="name"/>
                <field name="asset_ids" widget="many2many_tags" optional="show"/>
                <field name="threat_id" optional="show"/>
                <field name="vulnerability_id" optional="show"/>
                <field name="likelihood" string="М"/>
                <field name="impact" string="Н"/>
                <field name="score"/>
                <field name="level" widget="badge"
                       decoration-danger="level == 'high'"
                       decoration-warning="level == 'medium'"
                       decoration-success="level == 'low'"/>
                <field name="treatment" optional="show"/>
                <field name="control_ids" widget="many2many_tags" optional="hide"/>
                <field name="residual_level" optional="show" widget="badge"
                       decoration-danger="residual_level == 'high'"
                       decoration-warning="residual_level == 'medium'"
                       decoration-success="residual_level == 'low'"/>
                <field name="owner_id" widget="many2one_avatar_user" optional="show"/>
                <field name="due_date" optional="hide"/>
                <field name="state" optional="show"/>
            </list>
        </field>
    </record>

    <record id="isms_risk_view_form" model="ir.ui.view">
        <field name="name">isms.risk.form</field>
        <field name="model">isms.risk</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_next_stage" type="object" string="Дараагийн үе шат" class="btn-primary"
                            invisible="state in ('implement', 'residual')" groups="university_isms.group_isms_analyst"/>
                    <button name="action_accept_residual" type="object" string="Үлдэгдэл эрсдэлийг батлах (6.1.3 f)"
                            class="btn-primary" invisible="state != 'implement'"
                            groups="university_isms.group_isms_asset_owner"
                            confirm="Эрсдэл хариуцагчийн хувьд үлдэгдэл эрсдэлийг хүлээн зөвшөөрч батлах уу?"/>
                    <button name="action_accept_risk" type="object" string="Эрсдэлийг хүлээн зөвшөөрөх"
                            invisible="state not in ('evaluate', 'respond') or accepted_by_id"
                            groups="university_isms.group_isms_manager"
                            confirm="Энэ эрсдэлийг албан ёсоор хүлээн зөвшөөрөх үү?"/>
                    <button name="action_create_task" type="object" string="Хариу арга хэмжээний даалгавар үүсгэх"
                            invisible="state not in ('respond', 'implement')" groups="university_isms.group_isms_analyst"/>
                    <button name="action_back_to_identify" type="object" string="Дахин үнэлэх"
                            invisible="state != 'residual'" groups="university_isms.group_isms_analyst"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_tasks" type="object" class="oe_stat_button" icon="fa-tasks"
                                groups="project.group_project_user">
                            <field name="task_count" widget="statinfo" string="Даалгавар"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Хугацаа хэтэрсэн" bg_color="text-bg-warning" invisible="not is_overdue"/>
                    <div class="oe_title">
                        <div class="text-muted"><field name="code" readonly="1"/></div>
                        <h1><field name="name" placeholder="жишээ: Фишингээр ажилтны данс булаагдаж дүн өөрчлөгдөх"/></h1>
                    </div>
                    <group>
                        <group string="1. Тодорхойлох">
                            <field name="asset_ids" widget="many2many_tags"/>
                            <field name="threat_id"/>
                            <field name="vulnerability_id"/>
                            <field name="owner_id" widget="many2one_avatar_user"/>
                        </group>
                        <group string="2–3. Шинжлэх, үнэлэх (5×5)">
                            <field name="likelihood"/>
                            <field name="impact"/>
                            <field name="score"/>
                            <field name="level" widget="badge"
                                   decoration-danger="level == 'high'"
                                   decoration-warning="level == 'medium'"
                                   decoration-success="level == 'low'"/>
                        </group>
                    </group>
                    <group>
                        <group string="4–5. Хариу арга хэмжээ">
                            <field name="treatment"/>
                            <field name="control_ids" widget="many2many_tags"/>
                            <field name="due_date"/>
                            <field name="accepted_by_id" invisible="not accepted_by_id"/>
                            <field name="accepted_date" invisible="not accepted_by_id"/>
                            <field name="is_overdue" invisible="1"/>
                        </group>
                        <group string="6. Үлдэгдэл эрсдэл">
                            <field name="residual_likelihood"/>
                            <field name="residual_impact"/>
                            <field name="residual_score"/>
                            <field name="residual_level" widget="badge"
                                   decoration-danger="residual_level == 'high'"
                                   decoration-warning="residual_level == 'medium'"
                                   decoration-success="residual_level == 'low'"/>
                            <field name="current_level"/>
                            <field name="residual_accepted_by_id" invisible="not residual_accepted_by_id"/>
                            <field name="residual_accepted_date" invisible="not residual_accepted_by_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Сценари" name="scenario">
                            <field name="description" placeholder="Аюул занал эмзэг байдлыг ашиглан хөрөнгөд хэрхэн нөлөөлөх вэ?"/>
                        </page>
                        <page string="Хариу арга хэмжээний төлөвлөгөө" name="plan">
                            <field name="treatment_plan"/>
                        </page>
                        <page string="Инцидент" name="incidents">
                            <field name="incident_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="severity"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="isms_risk_view_search" model="ir.ui.view">
        <field name="name">isms.risk.search</field>
        <field name="model">isms.risk</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="asset_ids"/>
                <field name="threat_id"/>
                <field name="vulnerability_id"/>
                <field name="control_ids"/>
                <field name="owner_id"/>
                <filter name="f_high" string="Өндөр" domain="[('level', '=', 'high')]"/>
                <filter name="f_medium" string="Дунд" domain="[('level', '=', 'medium')]"/>
                <filter name="f_low" string="Бага" domain="[('level', '=', 'low')]"/>
                <separator/>
                <filter name="f_mine" string="Миний хариуцсан" domain="[('owner_id', '=', uid)]"/>
                <filter name="f_accept" string="Хүлээн зөвшөөрсөн" domain="[('treatment', '=', 'accept')]"/>
                <filter name="f_overdue" string="Хугацаа хэтэрсэн" domain="[('is_overdue', '=', True)]"/>
                <filter name="f_residual_pending" string="Үлдэгдэл батлалт хүлээж буй" domain="[('state', '=', 'implement')]"/>
                <filter name="f_archived" string="Архивласан" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="g_level" string="Түвшин" context="{'group_by': 'level'}"/>
                    <filter name="g_state" string="Үе шат" context="{'group_by': 'state'}"/>
                    <filter name="g_treatment" string="Хариу арга хэмжээ" context="{'group_by': 'treatment'}"/>
                    <filter name="g_owner" string="Хариуцагч" context="{'group_by': 'owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="isms_risk_view_kanban" model="ir.ui.view">
        <field name="name">isms.risk.kanban</field>
        <field name="model">isms.risk</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="0">
                <field name="level"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <field name="code" class="text-muted"/>
                            <field name="level" widget="badge" class="ms-auto"
                                   decoration-danger="level == 'high'"
                                   decoration-warning="level == 'medium'"
                                   decoration-success="level == 'low'"/>
                        </div>
                        <field name="name" class="fw-bold"/>
                        <div class="d-flex mt-1 small">
                            <span>М×Н = <field name="score"/></span>
                            <field name="owner_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="isms_risk_view_pivot" model="ir.ui.view">
        <field name="name">isms.risk.pivot</field>
        <field name="model">isms.risk</field>
        <field name="arch" type="xml">
            <pivot string="Эрсдэлийн матриц 5×5" disable_linking="0">
                <field name="likelihood" type="row"/>
                <field name="impact" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="isms_risk_view_graph" model="ir.ui.view">
        <field name="name">isms.risk.graph</field>
        <field name="model">isms.risk</field>
        <field name="arch" type="xml">
            <graph string="Эрсдэлийн түвшин" type="bar" stacked="1">
                <field name="level"/>
                <field name="treatment"/>
            </graph>
        </field>
    </record>

    <record id="action_isms_risk" model="ir.actions.act_window">
        <field name="name">Эрсдэлийн бүртгэл (Risk Register)</field>
        <field name="res_model">isms.risk</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Эрсдэл бүртгэх</p>
            <p>Эрсдэлийн түвшин = Нөлөө × Магадлал (5×5 матриц). Хөрөнгө, аюул занал, эмзэг байдлыг холбож үнэлнэ.</p>
        </field>
    </record>
    <record id="action_isms_risk_matrix" model="ir.actions.act_window">
        <field name="name">Эрсдэлийн матриц 5×5</field>
        <field name="res_model">isms.risk</field>
        <field name="view_mode">pivot,graph,list,form</field>
    </record>
</odoo>
