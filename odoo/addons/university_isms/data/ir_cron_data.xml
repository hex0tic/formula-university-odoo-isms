<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Clause 9.1 / A.8.16: өдөр тутмын мониторинг -->
    <record id="ir_cron_isms_monitoring" model="ir.cron">
        <field name="name">ISMS: өдөр тутмын мониторинг (бодлогын хяналт, хугацаа хэтэрсэн эрсдэл, SLA)</field>
        <field name="model_id" ref="model_isms_monitoring"/>
        <field name="state">code</field>
        <field name="code">model._cron_daily_monitoring()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
