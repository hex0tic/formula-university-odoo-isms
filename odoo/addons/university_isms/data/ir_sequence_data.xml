<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_isms_asset" model="ir.sequence">
        <field name="name">ISMS хөрөнгө</field>
        <field name="code">isms.asset</field>
        <field name="prefix">AST-</field>
        <field name="padding">3</field>
    </record>
    <record id="seq_isms_risk" model="ir.sequence">
        <field name="name">ISMS эрсдэл</field>
        <field name="code">isms.risk</field>
        <field name="prefix">RSK-</field>
        <field name="padding">2</field>
    </record>
    <record id="seq_isms_incident" model="ir.sequence">
        <field name="name">ISMS инцидент</field>
        <field name="code">isms.incident</field>
        <field name="prefix">INC-%(year)s-</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_isms_policy" model="ir.sequence">
        <field name="name">ISMS бодлого</field>
        <field name="code">isms.policy</field>
        <field name="prefix">POL-</field>
        <field name="padding">2</field>
    </record>
</odoo>
