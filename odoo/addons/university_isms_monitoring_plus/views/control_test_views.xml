<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Тестийн төлөвлөгөө ===== -->
    <record id="isms_control_test_plan_view_list" model="ir.ui.view">
        <field name="name">isms.control.test.plan.list</field>
        <field name="model">isms.control.test.plan</field>
        <field name="arch" type="xml">
            <list string="Хяналтын тестийн төлөвлөгөө" decoration-danger="last_result in ('fail','error')"
                  decoration-success="last_result == 'pass'" decoration-muted="not active">
                <field name="code"/>
                <field name="name"/>
                <field name="control_id"/>
                <field name="method"/>
                <field name="frequency"/>
                <field name="owner_id"/>
                <field name="next_run_at" optional="show"/>
                <field name="last_run_at" optional="show"/>
                <field name="last_result" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="isms_control_test_plan_view_form" model="ir.ui.view">
        <field name="name">isms.control.test.plan.form</field>
        <field name="model">isms.control.test.plan</field>
        <field name="arch" type="xml">
            <form string="Хяналтын тест">
                <header>
                    <button name="action_run_now" type="object" string="Одоо ажиллуулах"
                            class="btn-primary" invisible="method != 'automated'"
                            groups="university_isms.group_isms_analyst,university_isms.group_isms_manager"/>
                    <button name="action_record_manual_run" type="object" string="Гүйцэтгэл бүртгэх"
                            class="btn-primary" invisible="method != 'manual'"
                            groups="university_isms.group_isms_analyst,university_isms.group_isms_auditor,university_isms.group_isms_manager"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label"><field name="code" readonly="1"/></span>
                        <h1><field name="name" placeholder="Тестийн нэр"/></h1>
                    </div>
                    <group>
                        <group string="Хяналт">
                            <field name="control_id"/>
                            <field name="method"/>
                            <field name="check_key" invisible="method != 'automated'" required="method == 'automated'"/>
                            <field name="severity" invisible="method != 'manual'"/>
                            <field name="effective_severity" invisible="method != 'automated'"/>
                        </group>
                        <group string="Товлолт">
                            <field name="frequency"/>
                            <field name="owner_id"/>
                            <field name="next_run_at" invisible="method != 'automated'"/>
                            <field name="last_run_at"/>
                            <field name="last_result"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Хамрах хүрээ" name="scope">
                            <group>
                                <field name="description" placeholder="Гар аргын тестийн алхмууд эсвэл тайлбар"/>
                                <field name="check_label" invisible="method != 'automated'"/>
                                <field name="check_scope" invisible="method != 'automated'"/>
                            </group>
                        </page>
                        <page string="Гүйцэтгэлийн түүх" name="runs">
                            <field name="run_ids" readonly="1">
                                <list create="0" edit="0" delete="0" decoration-danger="result in ('fail','error')"
                                      decoration-success="result == 'pass'">
                                    <field name="executed_at"/>
                                    <field name="executed_by_id"/>
                                    <field name="trigger"/>
                                    <field name="result"/>
                                    <field name="duration_ms"/>
                                    <field name="finding_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="isms_control_test_plan_action" model="ir.actions.act_window">
        <field name="name">Тестийн төлөвлөгөө</field>
        <field name="res_model">isms.control.test.plan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p>Annex A хяналт бүрт гар аргын болон автомат шалгалтын төлөвлөгөө.</p>
        </field>
    </record>

    <!-- ===== Гүйцэтгэлийн бүртгэл (append-only) ===== -->
    <record id="isms_control_test_run_view_list" model="ir.ui.view">
        <field name="name">isms.control.test.run.list</field>
        <field name="model">isms.control.test.run</field>
        <field name="arch" type="xml">
            <list string="Гүйцэтгэлийн бүртгэл" create="0" edit="0" delete="0"
                  decoration-danger="result in ('fail','error')" decoration-success="result == 'pass'">
                <field name="executed_at"/>
                <field name="plan_id"/>
                <field name="control_id"/>
                <field name="trigger"/>
                <field name="executed_by_id"/>
                <field name="result"/>
                <field name="finding_id"/>
                <field name="duration_ms" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="isms_control_test_run_view_form" model="ir.ui.view">
        <field name="name">isms.control.test.run.form.readonly</field>
        <field name="model">isms.control.test.run</field>
        <field name="arch" type="xml">
            <form string="Гүйцэтгэл" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="plan_id"/>
                            <field name="control_id"/>
                            <field name="method"/>
                            <field name="trigger"/>
                            <field name="executed_at"/>
                            <field name="executed_by_id"/>
                        </group>
                        <group>
                            <field name="result"/>
                            <field name="finding_id"/>
                            <field name="duration_ms"/>
                            <field name="window_key"/>
                        </group>
                    </group>
                    <group string="Хэмжилт, дэлгэрэнгүй">
                        <field name="details" nolabel="1"/>
                    </group>
                    <group string="Нотолгоо, алдаа">
                        <field name="evidence_text"/>
                        <field name="error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="isms_control_test_run_create_view" model="ir.ui.view">
        <field name="name">isms.control.test.run.form.create</field>
        <field name="model">isms.control.test.run</field>
        <field name="arch" type="xml">
            <form string="Гар аргын гүйцэтгэл бүртгэх">
                <sheet>
                    <group>
                        <field name="plan_id" readonly="1" force_save="1"/>
                        <field name="result" required="1"/>
                        <field name="details" placeholder="Хэмжсэн утга, ажиглалт (нууц утга оруулахгүй)"/>
                        <field name="evidence_text" placeholder="Нотолгооны тайлбар, баримтын дугаар"/>
                    </group>
                    <p class="text-muted">Бүртгэсний дараа засах боломжгүй. Бүтэлгүйтсэн үр дүн автоматаар олдвор үүсгэнэ.</p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="isms_control_test_run_action" model="ir.actions.act_window">
        <field name="name">Гүйцэтгэлийн бүртгэл</field>
        <field name="res_model">isms.control.test.run</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Хяналтын тестийн гүйцэтгэлийн түүх. Бичлэгийг засах, устгах боломжгүй.</p>
        </field>
    </record>
</odoo>
