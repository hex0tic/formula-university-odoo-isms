<odoo noupdate="1">
    <record id="team_security" model="helpdesk.ticket.team">
        <field name="name">Formula University ISMS — Security Response</field>
        <field name="show_in_portal" eval="False"/>
        <field name="sequence">1</field>
    </record>
    <record id="stage_incident" model="helpdesk.ticket.stage"><field name="name">Incident</field><field name="sequence">10</field><field name="team_ids" eval="[(4, ref('team_security'))]"/></record>
    <record id="stage_report" model="helpdesk.ticket.stage"><field name="name">Report</field><field name="sequence">20</field><field name="team_ids" eval="[(4, ref('team_security'))]"/></record>
    <record id="stage_investigate" model="helpdesk.ticket.stage"><field name="name">Investigate</field><field name="sequence">30</field><field name="team_ids" eval="[(4, ref('team_security'))]"/></record>
    <record id="stage_resolve" model="helpdesk.ticket.stage"><field name="name">Resolve</field><field name="sequence">40</field><field name="team_ids" eval="[(4, ref('team_security'))]"/></record>
    <record id="stage_close" model="helpdesk.ticket.stage"><field name="name">Close</field><field name="sequence">50</field><field name="closed" eval="True"/><field name="fold" eval="True"/><field name="team_ids" eval="[(4, ref('team_security'))]"/></record>
</odoo>
