<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="isms_evidence_export_wizard_view_form" model="ir.ui.view">
        <field name="name">isms.evidence.export.wizard.form</field>
        <field name="model">isms.evidence.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Аудитын экспорт">
                <p>Сонгосон Annex A хяналт бүрийн батлагдсан, хүчинтэй нотолгоог багцлана. Дутуу хяналтууд
                    тусдаа жагсаалтад орно. Багц таны эрхээр бүтээгдэнэ.</p>
                <group>
                    <field name="control_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Багц үүсгэх" class="btn-primary"/>
                    <button special="cancel" string="Болих"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="isms_evidence_export_view_list" model="ir.ui.view">
        <field name="name">isms.evidence.export.list</field>
        <field name="model">isms.evidence.export</field>
        <field name="arch" type="xml">
            <list string="Аудитын багц" create="0">
                <field name="name"/>
                <field name="generated_at"/>
                <field name="requested_by_id" widget="many2one_avatar_user"/>
                <field name="control_count"/>
                <field name="covered_count"/>
                <field name="missing_count"/>
                <field name="is_complete" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="isms_evidence_export_view_form" model="ir.ui.view">
        <field name="name">isms.evidence.export.form</field>
        <field name="model">isms.evidence.export</field>
        <field name="arch" type="xml">
            <form string="Аудитын багц" create="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="is_complete">
                        Багц дутуу: нотолгоогүй хяналтууд байна. Жагсаалтыг missing.csv-ээс харна уу.
                    </div>
                    <group>
                        <group string="Үүсгэсэн">
                            <field name="requested_by_id" widget="many2one_avatar_user"/>
                            <field name="generated_at"/>
                        </group>
                        <group string="Бүрэн байдал">
                            <field name="completeness_text" nolabel="1"/>
                            <field name="control_count"/>
                            <field name="covered_count"/>
                            <field name="missing_count"/>
                            <field name="file_count"/>
                        </group>
                    </group>
                    <group string="Багц">
                        <field name="zip_file" filename="zip_filename"/>
                        <field name="zip_sha256"/>
                    </group>
                    <field name="control_ids" widget="many2many_tags"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_isms_evidence_export_wizard" model="ir.actions.act_window">
        <field name="name">Аудитын экспорт үүсгэх</field>
        <field name="res_model">isms.evidence.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_isms_evidence_export" model="ir.actions.act_window">
        <field name="name">Экспортын бүртгэл</field>
        <field name="res_model">isms.evidence.export</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
