<odoo>
    <record id="view_inventory_asset_catalog" model="ir.ui.view">
        <field name="name">product.product.isms.asset.catalog</field><field name="model">product.product</field>
        <field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="default_code" string="Код"/><field name="name" string="Хөрөнгө"/><field name="type" string="Каталогийн төрөл"/><field name="isms_catalog_owner_id"/><field name="isms_catalog_classification"/><field name="isms_catalog_location"/><field name="isms_catalog_risk" widget="badge"/></list></field>
    </record>
    <record id="action_inventory_asset_catalog" model="ir.actions.act_window">
        <field name="name">Inventory — ISMS хөрөнгийн бүртгэл</field><field name="res_model">product.product</field>
        <field name="view_mode">list,form</field><field name="view_id" ref="view_inventory_asset_catalog"/>
        <field name="domain">[('isms_catalog_asset_id', '!=', False)]</field>
    </record>
    <menuitem id="menu_inventory_asset_catalog" name="ISMS хөрөнгийн бүртгэл" parent="stock.menu_stock_root" action="action_inventory_asset_catalog" sequence="8" groups="university_isms.group_isms_analyst,university_isms.group_isms_auditor"/>
    <menuitem id="menu_catalog_standalone" name="Inventory ISMS Register" action="action_inventory_asset_catalog" sequence="8" groups="university_isms.group_isms_analyst,university_isms.group_isms_auditor"/>
</odoo>
